{
  "expo": {
    "name": "MyPushApp",
    "slug": "my-push-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mypushapp",
    "plugins": [
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "com.currenciesdirect.mobileappdev",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.currenciesdirect.mobileappdev",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "90315087-c360-4629-8e6f-e17d39500eaf"
      }
    },
    "owner": "abhay789"
  }
}
